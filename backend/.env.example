# Port du serveur (par défaut 5000 en dev)
PORT=5000

# URI de connexion MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/cineverse

# Secret JWT (chaîne aléatoire longue, min 32 caractères)
JWT_SECRET=your_jwt_secret_here_change_in_production

# URL du frontend (séparer plusieurs URLs par des virgules)
FRONTEND_URL=http://localhost:5173

# Google OAuth Client ID (optionnel, pour login Google)
GOOGLE_CLIENT_ID=your_google_client_id_here